# ============================================================
# Memora 配置文件示例
# 复制本文件为 configs/config.yaml 并填写正确的值
# 环境变量优先级更高，配置项可通过 MEMORA_* 环境变量覆盖
# ============================================================

# 应用配置
app:
  name: "memora"
  version: "dev"
  mode: "debug"           # debug, release, test
  address: ":8080"
  read_timeout: 15s       # 单位/秒
  write_timeout: 15s      # 单位/秒
  shutdown_timeout: 10s   # 单位/秒

# 数据库配置（PostgreSQL，使用超级用户连接；密码按本机安装填写）
database:
  url: "postgres://postgres:root@localhost:5432/memora?sslmode=disable"
  max_idle_conns: 5
  max_open_conns: 25

# Redis 配置
redis:
  address: "localhost:6379"
  password: ""
  db: 0
  pool_size: 10

# MinIO 配置
minio:
  endpoint: "localhost:9000"
  access_key: "minioadmin"
  secret_key: "minioadmin"
  bucket: "memora"
  use_ssl: false

# JWT 配置
jwt:
  secret: "change-me"
  access_ttl: 2h         # 单位/小时

# 后台 Worker 配置
worker:
  concurrency: 4
  poll_interval: 2s      # 单位/秒
  default_timeout: 5m    # 单位/分钟
  max_retry_delay: 1m    # 单位/分钟
  idempotency_ttl: 24h   # 单位/小时

# MCP
mcp:
  encryption_key: "change-me-mcp-encryption-key-32bytes"
  stdio_command_whitelist: ["npx", "python", "python3", "uvx", "node"]
  allow_local_http: false


# 日志配置
log:
  level: "info"          # debug, info, warn, error
  filename: ""           # 留空输出到控制台
  max_size: 100          # MB
  max_backups: 3         # 保留旧文件的最大个数
  max_age: 28            # 保留旧文件的最大天数
  compress: true         # 是否压缩

# CORS 配置
cors:
  enabled: true
  allow_origins:
    # 具体的前端地址
    - "http://localhost:3000"
  allow_methods:
    - "GET"
    - "POST"
    - "PUT"
    - "PATCH"
    - "DELETE"
    - "OPTIONS"
  allow_headers:
    - "Origin"
    - "Content-Type"
    - "Authorization"
    - "X-Request-ID"
    - "traceparent"
  expose_headers:
    - "X-Request-ID"
    - "X-Trace-ID"
  allow_credentials: true
  max_age: 86400
