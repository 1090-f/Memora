# ============================================================
# Memora 配置文件示例
# 复制本文件为 configs/config.yaml 并填写正确的值
# 环境变量优先级更高，配置项可通过 MEMORA_* 环境变量覆盖
# ============================================================

# 应用配置
app:
  name: "memora"
  version: "dev"
  mode: "debug"           # debug, release, test
  address: ":8080"
  read_timeout: 2m        # 单位/秒
  write_timeout: 10m      # 单位/秒（Python 解析最长约 8 分钟、LibreOffice 转换最长约 5 分钟）
  shutdown_timeout: 10s   # 单位/秒

# 数据库配置（与 deploy/docker-compose.yml 的默认配置一致）
database:
  url: "postgres://memora:password@192.168.21.15:15432/memora?sslmode=disable"
  max_idle_conns: 5
  max_open_conns: 25

# Redis 配置
redis:
  address: "192.168.21.15:16379"
  password: ""
  db: 3
  pool_size: 10

# MinIO 配置
minio:
  endpoint: "192.168.21.15:19000"
  access_key: "minioadmin"
  secret_key: "minioadmin"
  bucket: "memora"
  use_ssl: false

# JWT 配置
jwt:
  secret: "change-me"
  access_ttl: 2h         # 单位/小时

# API 进程内 Redis Stream 文档消费者
document_consumer:
  enabled: true
  stream: "memora:document:parse"
  group: "memora-api"
  concurrency: 2
  block_timeout: 5s
  processing_timeout: 15m
  claim_idle: 20m
  max_attempts: 3

outbox:
  poll_interval: 500ms
  batch_size: 100

# 旧索引版本后台清理（删除已软删除文档与超出保留版本的旧索引 Chunk/向量）
index_cleanup:
  enabled: true
  interval: 1h
  retention: 1            # 保留的旧版本数（0 表示只保留当前 active 版本）

# 文档视觉预览（独立于解析/索引流水线）
preview:
  enabled: true
  consumer:
    stream: "memora:document:preview"
    group: "memora-preview"
    concurrency: 2
    block_timeout: 5s
    processing_timeout: 10m
    claim_idle: 15m
    max_attempts: 3
  office:
    enabled: true
    max_concurrency: 1
    timeout: 5m
  xlsx:
    enabled: true
    max_sheets: 100
    max_rows_per_sheet: 100000
    max_columns_per_sheet: 500
    max_cells: 500000
    max_uncompressed_bytes: 67108864

# MCP
mcp:
  encryption_key: "change-me-mcp-encryption-key-32bytes"
  stdio_command_whitelist: ["npx", "python", "python3", "uvx", "node"]
  allow_local_http: false


# 日志配置
log:
  level: "info"          # debug, info, warn, error
  filename: ""           # 留空输出到控制台
  max_size: 100          # MB
  max_backups: 3         # 保留旧文件的最大个数
  max_age: 28            # 保留旧文件的最大天数
  compress: true         # 是否压缩

# CORS 配置
cors:
  enabled: true
  allow_origins:
    # 具体的前端地址
    - "http://localhost:3000"
  allow_methods:
    - "GET"
    - "POST"
    - "PUT"
    - "PATCH"
    - "DELETE"
    - "OPTIONS"
  allow_headers:
    - "Origin"
    - "Content-Type"
    - "Authorization"
    - "X-Request-ID"
    - "traceparent"
  expose_headers:
    - "X-Request-ID"
    - "X-Trace-ID"
  allow_credentials: true
  max_age: 86400

# 文档解析（Python document-parser 客户端；只含解析选项，不含 Chunk 参数）
document_parser:
  base_url: "http://127.0.0.1:5001"
  auto_start: true                     # 主程序统一托管 Python 解析服务
  auto_start_command: "uv"
  auto_start_args: ["run", "--frozen", "--no-dev", "uvicorn", "app:app", "--host", "127.0.0.1", "--port", "5001"]
  auto_start_working_directory: "./services/document-parser"
  auto_start_timeout: 10m
  auto_start_environment:
    PYTHONUTF8: "1"
    TORCH_COMPILE_DISABLE: "1"
  timeout: 8m
  max_response_size: 134217728
  max_file_bytes: 67108864
  max_asset_bytes: 33554432
  ocr_languages: ["zh", "en"]
  do_ocr: true
  do_image_ocr: true      # 文档内图片的二级 OCR（独立于整页/整图文档的 do_ocr）
  table_structure: true
  extract_pictures: true
  include_bboxes: true

# Go 分块策略（进入 chunk_config_hash）
chunking:
  strategy: "structured"              # structured / paragraph / recursive_fallback / auto
  strategy_version: "structure-v1"
  use_canonical_chunker: false         # 灰度开关；false 时 Canonical 仅影子生成
  enable_canonical_chunk_diff: false   # 影子双跑旧/新分块器并生成边界、来源差异报告
  max_tokens: 1000
  min_tokens: 100
  overlap_tokens: 100
  repeat_table_header: true

# 图片资产增强（独立 config hash）
asset_enrichment:
  mode: "none"
  timeout: 2m

# URL 导入（Worker 内安全抓取）
url_import:
  timeout: 30s
  max_response_bytes: 10485760
  max_redirects: 5

ai:
  encryption_key: "change-me-ai-encryption-key"

# Agent 配置
agent:
  max_tool_calls: 10         # 单次运行最大工具调用次数
  max_tool_result_bytes: 1048576  # 工具结果最大字节数（1MB）
  max_run_seconds: 300       # 单次运行最大时长（秒）
