app:
  name: memora
  version: dev
  mode: debug
  address: ":8080"
  read_timeout: 15s
  write_timeout: 15s
  shutdown_timeout: 10s

database:
  url: "postgres://memora:password@localhost:5432/memora?sslmode=disable"
  max_idle_conns: 5
  max_open_conns: 25

redis:
  address: "localhost:6379"
  password: ""
  db: 0
  pool_size: 10

minio:
  endpoint: "localhost:9000"
  access_key: minioadmin
  secret_key: minioadmin
  bucket: memora
  use_ssl: false

jwt:
  secret: change-me
  access_ttl: 2h

worker:
  concurrency: 4
  poll_interval: 2s
  default_timeout: 5m
  max_retry_delay: 1m
  idempotency_ttl: 24h

mcp:
  encryption_key: "change-me-mcp-encryption-key-32bytes"
  stdio_command_whitelist: ["npx", "python", "python3", "uvx", "node"]
  allow_local_http: false

log:
  level: info
  filename: ""
  max_size: 100
  max_backups: 3
  max_age: 28
  compress: true

cors:
  enabled: true
  allow_origins: ["http://localhost:3000"]
  allow_methods: ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
  allow_headers: ["Origin", "Content-Type", "Authorization", "X-Request-ID", "traceparent"]
  expose_headers: ["X-Request-ID", "X-Trace-ID"]
  allow_credentials: true
  max_age: 86400
