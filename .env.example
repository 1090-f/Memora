# ============================================================
# Memora 环境变量示例
# 复制本文件为 .env 并填写正确的值
# 配置项也可写在 configs/config.yaml 中，环境变量优先级更高
# ============================================================

# 应用配置
MEMORA_GIN_MODE=debug
MEMORA_HTTP_ADDRESS=:8080
MEMORA_HTTP_READ_TIMEOUT=2m
MEMORA_HTTP_WRITE_TIMEOUT=10m
MEMORA_HTTP_SHUTDOWN_TIMEOUT=10s

# 数据库配置（与 deploy/docker-compose.yml 的默认配置一致）
MEMORA_DATABASE_URL=postgres://memora:password@192.168.21.8:15432/memora?sslmode=disable
MEMORA_DATABASE_MAX_OPEN=25
MEMORA_DATABASE_MAX_IDLE=5

# Redis 配置
MEMORA_REDIS_ADDRESS=192.168.21.8:16379
MEMORA_REDIS_PASSWORD=
MEMORA_REDIS_DB=3
MEMORA_REDIS_POOL_SIZE=10

# MinIO 配置
MEMORA_MINIO_ENDPOINT=192.168.21.8:19000
MEMORA_MINIO_ACCESS_KEY=minioadmin
MEMORA_MINIO_SECRET_KEY=minioadmin
MEMORA_MINIO_BUCKET=memora
MEMORA_MINIO_USE_SSL=false

# JWT 配置
MEMORA_JWT_SECRET=change-me
MEMORA_ACCESS_TTL=2h

# 后台 Worker 配置
MEMORA_WORKER_CONCURRENCY=4
MEMORA_WORKER_POLL_INTERVAL=2s
MEMORA_WORKER_DEFAULT_TIMEOUT=5m
MEMORA_WORKER_MAX_RETRY_DELAY=1m
MEMORA_WORKER_IDEMPOTENCY_TTL=24h

# 日志配置
MEMORA_LOG_LEVEL=info
MEMORA_LOG_FILENAME=
MEMORA_LOG_MAX_SIZE=100
MEMORA_LOG_MAX_BACKUPS=3
MEMORA_LOG_MAX_AGE=28
MEMORA_LOG_COMPRESS=true

# 初始管理员账号（仅首次启动时创建）
MEMORA_BOOTSTRAP_ADMIN_USERNAME=admin
MEMORA_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
MEMORA_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin

# MCP
MEMORA_MCP_ENCRYPTION_KEY=change-me-mcp-encryption-key-32bytes
MEMORA_MCP_ALLOW_LOCAL_HTTP=false

# URL 导入（Worker 内安全抓取）
MEMORA_URL_IMPORT_TIMEOUT=30s
MEMORA_URL_IMPORT_MAX_RESPONSE_BYTES=10485760
MEMORA_URL_IMPORT_MAX_REDIRECTS=5

# 文档解析服务（由 memora-server 在同一进程容器内托管）
MEMORA_DOCUMENT_PARSER_AUTO_START=true
MEMORA_DOCUMENT_PARSER_AUTO_START_TIMEOUT=10m
MEMORA_DOCUMENT_PARSER_DO_IMAGE_OCR=true
DOCUMENT_PARSER_LOG_LEVEL=info
DOCUMENT_PARSER_MAX_CONCURRENCY=2

# 文档视觉预览 Worker
MEMORA_PREVIEW_ENABLED=true
MEMORA_PREVIEW_CONSUMER_STREAM=memora:document:preview
MEMORA_PREVIEW_CONSUMER_GROUP=memora-preview
MEMORA_PREVIEW_CONSUMER_CONCURRENCY=2
MEMORA_PREVIEW_CONSUMER_PROCESSING_TIMEOUT=10m
MEMORA_PREVIEW_CONSUMER_CLAIM_IDLE=15m
MEMORA_PREVIEW_CONSUMER_MAX_ATTEMPTS=3
MEMORA_PREVIEW_OFFICE_ENABLED=true
MEMORA_PREVIEW_OFFICE_MAX_CONCURRENCY=1
MEMORA_PREVIEW_OFFICE_TIMEOUT=5m
MEMORA_PREVIEW_XLSX_ENABLED=true

# AI 模型 API Key 加密（生产环境使用独立强随机值）
MEMORA_AI_ENCRYPTION_KEY=change-me-ai-encryption-key
