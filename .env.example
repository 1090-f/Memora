# ============================================================
# Memora 环境变量示例
# 复制本文件为 .env 并填写正确的值
# 配置项也可写在 configs/config.yaml 中，环境变量优先级更高
# ============================================================

# 应用配置
MEMORA_GIN_MODE=debug
MEMORA_HTTP_ADDRESS=:8080
MEMORA_HTTP_READ_TIMEOUT=15s
MEMORA_HTTP_WRITE_TIMEOUT=15s
MEMORA_HTTP_SHUTDOWN_TIMEOUT=10s

# 数据库配置（PostgreSQL）
MEMORA_DATABASE_URL=postgres://memora:password@localhost:5432/memora?sslmode=disable
MEMORA_DATABASE_MAX_OPEN=25
MEMORA_DATABASE_MAX_IDLE=5

# Redis 配置
MEMORA_REDIS_ADDRESS=localhost:6379
MEMORA_REDIS_PASSWORD=
MEMORA_REDIS_DB=0
MEMORA_REDIS_POOL_SIZE=10

# MinIO 配置
MEMORA_MINIO_ENDPOINT=localhost:9000
MEMORA_MINIO_ACCESS_KEY=minioadmin
MEMORA_MINIO_SECRET_KEY=minioadmin
MEMORA_MINIO_BUCKET=memora
MEMORA_MINIO_USE_SSL=false

# JWT 配置
MEMORA_JWT_SECRET=change-me
MEMORA_ACCESS_TTL=2h

# 后台 Worker 配置
MEMORA_WORKER_CONCURRENCY=4
MEMORA_WORKER_POLL_INTERVAL=2s
MEMORA_WORKER_DEFAULT_TIMEOUT=5m
MEMORA_WORKER_MAX_RETRY_DELAY=1m
MEMORA_WORKER_IDEMPOTENCY_TTL=24h

# 日志配置
MEMORA_LOG_LEVEL=info
MEMORA_LOG_FILENAME=
MEMORA_LOG_MAX_SIZE=100
MEMORA_LOG_MAX_BACKUPS=3
MEMORA_LOG_MAX_AGE=28
MEMORA_LOG_COMPRESS=true

# 初始管理员账号（仅首次启动时创建）
MEMORA_BOOTSTRAP_ADMIN_USERNAME=admin
MEMORA_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
MEMORA_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin
